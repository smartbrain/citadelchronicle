        </PageObject>
        <PageObject XPosition="119.842519685039" YPosition="1868.8188976378" OwnPage="2" ItemID="1947148621" ItemType="4" Width="555.590551181102" Height="14.1732283464567" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L555.591 0 L555.591 14.1732 L0 14.1732 L0 0 Z" ContourLinePath="M0 0 L555.591 0 L555.591 14.1732 L0 14.1732 L0 0 Z" gXpos="119.842519685039" gYpos="1868.8188976378" gWidth="0" gHeight="0" Alignment="1" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="1" Font="Liberation Mono Bold" FontSize="7.2"/>
                <Content Font="Liberation Mono Bold" FontSize="7.2" FontColor="CitadelCrimson" Chars="HOW ROGUE SERVERS EXPLOITED THE SPV MEMPOOL BLINDSPOT TO TRICK BITCOINERS INTO SIGNING OVER THEIR OWN FUNDS"/>
                <trail Alignment="1"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="134.015748031496" YPosition="1882.99212598425" OwnPage="2" ItemID="425391189" ItemType="4" Width="527.244094488189" Height="21.259842519685" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L527.244 0 L527.244 21.2598 L0 21.2598 L0 0 Z" ContourLinePath="M0 0 L527.244 0 L527.244 21.2598 L0 21.2598 L0 0 Z" gXpos="134.015748031496" gYpos="1882.99212598425" gWidth="0" gHeight="0" Alignment="1" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="1" Font="Liberation Serif Italic" FontSize="7.5"/>
                <Content Font="Liberation Serif Italic" FontSize="7.5" Chars="A forensic examination of the high-severity vulnerability patched in Electrum v4.8.3, where adversaries bypassed private-key cryptography by turning the client's Replace-By-Fee routine into an involuntary double-spend guillotine."/>
                <trail Alignment="1"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="119.842519685039" YPosition="1907.08661417323" OwnPage="2" ItemID="984712151" ItemType="5" Width="555.590551181102" Height="1" FrameType="0" ClipEdited="0" LineWidth="0.6" FillShade="4.24399158884746e-314" LineColor="Black" LinePenStyle="1" Path="" gXpos="119.842519685039" gYpos="1907.08661417323" gWidth="0" gHeight="0" Layer="0"/>
        <PageObject XPosition="119.842519685039" YPosition="1911.33858267717" OwnPage="2" ItemID="494989721" ItemType="4" Width="266.456692913386" Height="504.566929133858" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L266.457 0 L266.457 504.567 L0 504.567 L0 0 Z" ContourLinePath="M0 0 L266.457 0 L266.457 504.567 L0 504.567 L0 0 Z" gXpos="119.842519685039" gYpos="1911.33858267717" gWidth="0" gHeight="0" Alignment="3" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="3" Font="Liberation Serif Regular" FontSize="6.7"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="On 24 October 2026, the maintainers of the Electrum Bitcoin wallet published a security advisory tracked as GHSA-6jp4-8v48-cc5v and rushed out version 4.8.3. The vulnerability had not merely been discovered in an academic laboratory; it had been actively and ruthlessly exploited in the wild against users operating on public Electrum servers."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="What makes this exploit one of the most intellectually diabolical vectors in Bitcoin client history is that the adversary never broke secp256k1 elliptic curve cryptography, nor did they exfiltrate seed phrases or compromise operating systems. Instead, they weaponised the client’s architectural trust boundary and the user’s own muscle memory, tricking victims into voluntarily authorising and signing the theft of their own coins."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="THE SPV MEMPOOL BLINDSPOT"/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="To understand how the heist operates, one must examine the delicate compromise that makes lightweight Bitcoin wallets possible. In Satoshi Nakamoto’s original design, Simplified Payment Verification (SPV) relies upon 80-byte block headers. When an SPV client receives a confirmed transaction, it cryptographically verifies a Merkle inclusion proof tying that transaction hash to a header buried under cumulative Proof-of-Work. An untrusted server cannot fabricate a confirmed block without overcoming the hashpower of the global network."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="For unconfirmed transactions floating in the mempool, however, this cryptographic anchor vanishes entirely. In the mempool, there is no Proof-of-Work, no consensus, and no Merkle tree."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="When an Electrum client synchronises with an external server over JSON-RPC, it queries its addresses via blockchain.scripthash.subscribe. If a transaction has a height of zero or negative, the server asserts that it is an unconfirmed payment sitting in the mempool."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="Historically, Electrum’s codebase contained a fateful assumption: if an unconfirmed transaction consumed UTXOs belonging to the local wallet (wallet.is_mine), the wallet assumed it was either created by the local user or broadcast from another valid clone. Crucially, pre-4.8.3 Electrum did not execute the script engine to cryptographically verify signatures on unconfirmed incoming inputs."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="PHASE 1 &amp; 2: INTERCEPTION &amp; SYNTHETIC FORGERY"/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="The ambush begins when an unsuspecting user broadcasts a legitimate payment (Tx1)—for example, transferring 2.5 BTC to cold storage. The client relays Tx1 to its connected Electrum server via blockchain.transaction.broadcast. If that server is malicious, it silently suppresses Tx1, refusing to gossip it to the broader Bitcoin P2P network."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="The rogue server immediately constructs an alternative transaction (Tx_fake). It consumes the exact same UTXOs as Tx1, but redirects the output entirely to an address controlled by the attacker. Because the attacker possesses no private keys, Tx_fake contains invalid dummy signatures. Attackers deployed GPU vanity tools so the final four to six characters matched the victim’s intended address, set a fee of 1 sat/vB with BIP 125 opt-in RBF, and fed Tx_fake back to the wallet. Because Electrum skipped signature checks, the fake transaction appeared in the GUI as a pending payment."/>
                <trail Alignment="3"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="403.307086614173" YPosition="1911.33858267717" OwnPage="2" ItemID="2144405275" ItemType="4" Width="272.125984251969" Height="147.40157480315" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L272.126 0 L272.126 147.402 L0 147.402 L0 0 Z" ContourLinePath="M0 0 L272.126 0 L272.126 147.402 L0 147.402 L0 0 Z" gXpos="403.307086614173" gYpos="1911.33858267717" gWidth="0" gHeight="0" Alignment="3" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="3" Font="Liberation Serif Regular" FontSize="6.7"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="PHASE 3 &amp; 4: THE RBF TRAP AND FATAL RATIFICATION"/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="Because Tx_fake contained invalid signatures, no honest miner would ever include it in a block. To the user, the transaction appeared hopelessly stalled in the mempool."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="The natural reaction in Bitcoin UX when a transaction is stuck is to right-click and select “Increase Fee” (Replace-By-Fee). When the user initiated the fee bump, Electrum loaded Tx_fake from its internal history as the base transaction template. The UI displayed a dialogue asking for a higher fee rate."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="Human psychology and standard hardware wallet UX conspired to seal the trap. When performing an RBF bump, users invariably check only the fee delta (e.g. bumping from 1 sat/vB to 35 sat/vB), assuming the recipient address is immutable from their initial creation."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="The victim typed their passphrase or approved the prompt on their Ledger, Trezor, or Coldcard. In doing so, the wallet generated pristine, mathematically valid ECDSA or Schnorr signatures over the attacker’s outputs. The resulting transaction was immediately relayed, accepted by Bitcoin Core mempools across the globe, and permanently mined into the ledger. The theft was absolute."/>
                <trail Alignment="3"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="403.307086614173" YPosition="2061.57480314961" OwnPage="2" ItemID="722023680" ItemType="6" Width="272.125984251969" Height="107.716535433071" FrameType="0" ClipEdited="0" LineWidth="1" FillColor="CreamYellow" LineColor="CitadelCrimson" LinePenStyle="1" Path="M0 0 L272.126 0 L272.126 107.717 L0 107.717 L0 0 Z" ContourLinePath="M0 0 L272.126 0 L272.126 107.717 L0 107.717 L0 0 Z" gXpos="403.307086614173" gYpos="2061.57480314961" gWidth="0" gHeight="0" Layer="0"/>
        <PageObject XPosition="406.141732283465" YPosition="2064.4094488189" OwnPage="2" ItemID="674765617" ItemType="4" Width="266.456692913386" Height="102.047244094488" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L266.457 0 L266.457 102.047 L0 102.047 L0 0 Z" ContourLinePath="M0 0 L266.457 0 L266.457 102.047 L0 102.047 L0 0 Z" gXpos="406.141732283465" gYpos="2064.4094488189" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Font="Liberation Mono Regular" FontSize="5.2"/>
                <Content Font="Liberation Mono Regular" FontSize="5.2" Chars="▲ THE ANATOMY OF THE RBF TRAP (GHSA-6jp4-8v48-cc5v) ▲"/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5.2" Chars="1. VICTIM broadcasts Tx1 (Valid recipient, fully signed)."/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5.2" Chars="2. ROGUE SERVER withholds Tx1 from P2P gossip network."/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5.2" Chars="3. SERVER INJECTS Tx_fake (Same UTXO, vanity attacker output, BOGUS signatures)."/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5.2" Chars="4. CLIENT ACCEPTS Tx_fake into GUI (Skipped unconfirmed sig check!)."/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5.2" Chars="5. TX STALLS: Victim right-clicks 'Increase Fee' (RBF)."/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5.2" Chars="6. FATAL RATIFICATION: Victim signs fee bump • Wallet generates real, valid signatures over the attacker's output!"/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5.2" Chars="7. THEFT COMPLETE: Valid Tx_stolen mined on chain."/>
                <trail/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="403.307086614173" YPosition="2174.96062992126" OwnPage="2" ItemID="998716507" ItemType="4" Width="272.125984251969" Height="90.7086614173228" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L272.126 0 L272.126 90.7087 L0 90.7087 L0 0 Z" ContourLinePath="M0 0 L272.126 0 L272.126 90.7087 L0 90.7087 L0 0 Z" gXpos="403.307086614173" gYpos="2174.96062992126" gWidth="0" gHeight="0" Alignment="3" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="3" Font="Liberation Serif Regular" FontSize="6.7"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="THE REMEDIATION: COMMIT 90fe308"/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.7" Chars="Lead maintainer SomberNight resolved the flaw in commit 90fe308 by dismantling the assumption of mempool innocence. Electrum v4.8.3 now enforces strict client-side signature verification: before any unconfirmed transaction touching wallet.is_mine UTXOs is accepted into the wallet database, the client validates that the input signatures mathematically correspond to the scriptPubKey. Any forged or invalid server injection is rejected outright and never reaches the GUI."/>
                <trail Alignment="3"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="403.307086614173" YPosition="2271.33858267717" OwnPage="2" ItemID="471877170" ItemType="6" Width="272.125984251969" Height="141.732283464567" FrameType="0" ClipEdited="0" LineWidth="1" FillColor="PaperWarm" LineColor="Black" LinePenStyle="1" Path="M0 0 L272.126 0 L272.126 141.732 L0 141.732 L0 0 Z" ContourLinePath="M0 0 L272.126 0 L272.126 141.732 L0 141.732 L0 0 Z" gXpos="403.307086614173" gYpos="2271.33858267717" gWidth="0" gHeight="0" Layer="0"/>
        <PageObject XPosition="406.141732283465" YPosition="2274.17322834646" OwnPage="2" ItemID="191978844" ItemType="4" Width="266.456692913386" Height="136.062992125984" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L266.457 0 L266.457 136.063 L0 136.063 L0 0 Z" ContourLinePath="M0 0 L266.457 0 L266.457 136.063 L0 136.063 L0 0 Z" gXpos="406.141732283465" gYpos="2274.17322834646" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Font="Liberation Mono Regular" FontSize="5.5"/>
                <Content Font="Liberation Mono Regular" FontSize="5.5" Chars="■ LESSONS FOR THE CITADEL SANCTUARY    |    SOVEREIGN MANDATE"/>
                <para/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5.5" Chars="• UPGRADE MANDATORY: All users operating Electrum must update to version 4.8.3 or higher. Verify PGP signatures directly from electrum.org."/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5.5" Chars="• INSPECT FULL OUTPUTS: Whenever executing an RBF fee bump, verify the entire recipient address on your hardware signer screen, not merely the fee rate."/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5.5" Chars="• RUN A SOVEREIGN SERVER: Users who connected to their own private Fulcrum, Electrs, or EPS nodes backed by Bitcoin Core were completely immune. Public servers are third-party trust traps. Don't trust, verify."/>
                <trail/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="119.842519685039" YPosition="2424.4094488189" OwnPage="2" ItemID="259761111" ItemType="5" Width="555.590551181102" Height="1" FrameType="0" ClipEdited="0" LineWidth="1.2" FillShade="4.24399158884746e-314" LineColor="Black" LinePenStyle="1" Path="" gXpos="119.842519685039" gYpos="2424.4094488189" gWidth="0" gHeight="0" Layer="0"/>
        <PageObject XPosition="119.842519685039" YPosition="2427.24409448819" OwnPage="2" ItemID="1135359773" ItemType="4" Width="555.590551181102" Height="11.3385826771654" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L555.591 0 L555.591 11.3386 L0 11.3386 L0 0 Z" ContourLinePath="M0 0 L555.591 0 L555.591 11.3386 L0 11.3386 L0 0 Z" gXpos="119.842519685039" gYpos="2427.24409448819" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Font="Liberation Mono Bold" FontSize="6"/>
                <Content Font="Liberation Mono Bold" FontSize="6" FontColor="CitadelCrimson" Chars="■ 0-CONF DISPATCHES • UNCONFIRMED MEMPOOL INTELLIGENCE &amp; JURISPRUDENCE    |    TRANSACTIONS STREAMING DIRECT FROM THE MEMPOOL"/>
                <trail/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="119.842519685039" YPosition="2440" OwnPage="2" ItemID="105237796" ItemType="5" Width="555.590551181102" Height="1" FrameType="0" ClipEdited="0" LineWidth="0.6" FillShade="1.90979621196756e-313" LineColor="Black" LinePenStyle="1" Path="" gXpos="119.842519685039" gYpos="2440" gWidth="0" gHeight="0" Layer="0"/>
        <PageObject XPosition="119.842519685039" YPosition="2444.25196850394" OwnPage="2" ItemID="1552786298" ItemType="4" Width="266.456692913386" Height="144.566929133858" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L266.457 0 L266.457 144.567 L0 144.567 L0 0 Z" ContourLinePath="M0 0 L266.457 0 L266.457 144.567 L0 144.567 L0 0 Z" gXpos="119.842519685039" gYpos="2444.25196850394" gWidth="0" gHeight="0" Alignment="3" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="3" Font="Liberation Serif Regular" FontSize="5.8"/>
                <Content Font="Liberation Serif Regular" FontSize="5.8" Chars="JURISPRUDENCE • SUPREME COURT EN BANC RULING 4929/2569"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="5.8" Chars="SATOSHI’S CASH BECOMES INVENTORIED CHATTEL"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="5.8" Chars="Thai Supreme Court rules 2.48 BTC is legally 'Property' in £40,000 Koh Samui beach heist."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="5.8" Chars="When Satoshi Nakamoto drafted his 2008 whitepaper, he titled it with spartan simplicity: Bitcoin: A Peer-to-Peer Electronic Cash System. The Thai judiciary, however, has codified a rather different taxonomy. In a historic en banc ruling (Supreme Court Decision No. 4929/2569), the Kingdom’s highest bench formally decreed that Bitcoin is not ephemeral cyber-dust, but bona fide incorporeal property under Sections 137 and 138 of the Civil and Commercial Code."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="5.8" Chars="The precedent stemmed from an extortion on Koh Samui, where a foreign gang coerced a couple in a café—under threats to their infant child—to convert $50,000 into 2.480801 BTC transferred to an offshore wallet. The defence claimed that because Bitcoin possesses no corporeal form and no state-mandated value, no robbery of chattel had occurred. The bench rejected the sophistry outright: holding that digital assets command measurable market value and exclusive dominion via cryptographic keys, the Court confirmed a ten-year penal stretch for armed robbery. Satoshi engineered sovereign cash; Thailand's prison wardens now treat it as fully confiscable property."/>
                <trail Alignment="3"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="394.803149606299" YPosition="2444.25196850394" OwnPage="2" ItemID="2047661039" ItemType="5" Width="141.732283464567" Height="1" FrameType="0" ClipEdited="0" Rotation="90" LineWidth="0.5" FillShade="3.75489890839347e-322" LineColor="GreyRule" LinePenStyle="1" Path="" gXpos="394.803149606299" gYpos="2444.25196850394" gWidth="0" gHeight="0" Layer="0"/>
        <PageObject XPosition="403.307086614173" YPosition="2444.25196850394" OwnPage="2" ItemID="796698115" ItemType="4" Width="272.125984251969" Height="144.566929133858" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L272.126 0 L272.126 144.567 L0 144.567 L0 0 Z" ContourLinePath="M0 0 L272.126 0 L272.126 144.567 L0 144.567 L0 0 Z" gXpos="403.307086614173" gYpos="2444.25196850394" gWidth="0" gHeight="0" Alignment="3" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="3" Font="Liberation Serif Regular" FontSize="5.8"/>
                <Content Font="Liberation Serif Regular" FontSize="5.8" Chars="FORENSIC AUDITING • THE COGNITIVE DEFICIT OF CRIME"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="5.8" Chars="KORN HAILS THE OPEN LEDGER; CRIMINALS FAIL ARITHMANCY"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="5.8" Chars="Former Finance Minister marvels at 118m-baht on-chain gambling trail, exposing the sub-standard intellect of cartel laundering."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="5.8" Chars="Former Finance Minister Korn Chatikavanij took to Facebook this week to shower unexpected praise upon public blockchains. Reflecting on a forensic dossier compiled by former Democrat MP Sirichok Sopa—who mapped nearly 10,000 transactions totaling 118 million Baht linked to illegal gambling platform Shuffle without requiring a single court warrant or bank subpoena—Korn proclaimed: 'Crypto is not the villain here; it may well be the hero.'"/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="5.8" Chars="While Mr. Korn noted that unlike opaque bank mule accounts or borderland bags of cash, public ledgers provide an indelible trail for the state, his diplomatic assessment delicately sidestepped the larger psychological reality: the comical IQ deficit of the modern money launderer. To launder illicit revenue across a globally broadcast, permanent ledger is akin to burgling a vault whilst wearing a high-visibility neon vest, a bodycam livestreaming to YouTube, and handing out numbered receipts. Satoshi gave humanity an unforgeable public receipt machine; only the most intellectually deficient cartels would choose it as a hideaway."/>
                <trail Alignment="3"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="119.842519685039" YPosition="2593.07086614173" OwnPage="2" ItemID="94982254" ItemType="5" Width="555.590551181102" Height="1" FrameType="0" ClipEdited="0" LineWidth="1" FillShade="3.75489890839347e-322" LineColor="Black" LinePenStyle="1" Path="" gXpos="119.842519685039" gYpos="2593.07086614173" gWidth="0" gHeight="0" Layer="0"/>
