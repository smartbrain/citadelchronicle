        <PageObject XPosition="386.299212598425" YPosition="2725.1968503937" OwnPage="3" ItemID="1029471526" ItemType="4" Width="192.755905511811" Height="212.59842519685" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L192.756 0 L192.756 212.598 L0 212.598 L0 0 Z" ContourLinePath="M0 0 L192.756 0 L192.756 212.598 L0 212.598 L0 0 Z" gXpos="386.299212598425" gYpos="2725.1968503937" gWidth="0" gHeight="0" Alignment="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="0" Font="Noto Serif Thai Regular" FontSize="5.8"/>
                <Content Font="Noto Serif Thai Regular" FontSize="5.8" Chars="ขอเชิญร่วมบุญทอดกฐินสามัคคี &amp; ยกเสาเอกเจดีย์"/>
                <para Alignment="0"/>
                <Content Font="Noto Serif Thai Regular" FontSize="5.8" Chars="Wat Khao Wanchai Nawarat Chedi Foundation • Pak Chong Gathering"/>
                <para Alignment="0"/>
                <para Alignment="0"/>
                <Content Font="Noto Serif Thai Regular" FontSize="5.8" Chars="สุดสัปดาห์นี้ ขอเรียนเชิญกัลยาณมิตร ศิษยานุศิษย์ และพี่น้องชาว Citadel ทุกท่าน ร่วมเดินทางสู่ อ.ปากช่อง จ.นครราชสีมา เพื่อร่วมบุญมหากุศลทอดกฐินสามัคคีสมทบทุนสร้าง &quot;รัตนเจดีย์ศรีดวงแก้วโพธิญาณ&quot; และมุทิตาสักการะอายุวัฒนมงคล 79 ปี หลวงพ่อพระครูภาวนาอุดมคุณ โดย อาจารย์โฉลก สัมพันธารักษ์ พร้อมครอบครัว และคณะศิษย์ CDC จะเดินทางไปร่วมสร้างมหาทานบารมีในครั้งนี้โดยพร้อมเพรียงกัน"/>
                <para Alignment="0"/>
                <para Alignment="0"/>
                <Content Font="Noto Serif Thai Regular" FontSize="5.8" Chars="กำหนดการสำคัญ (CEREMONIAL SCHEDULE)"/>
                <para Alignment="0"/>
                <Content Font="Noto Serif Thai Regular" FontSize="5.8" Chars="• เสาร์ 31 ต.ค.: 16.30 น. สรงน้ำหลวงพ่อพระครูภาวนาอุดมคุณ (79 ปี) • 19.00 น. ทำวัตรเย็น ปฏิบัติภาวนา ฟังธรรม"/>
                <para Alignment="0"/>
                <Content Font="Noto Serif Thai Regular" FontSize="5.8" Chars="• อาทิตย์ 1 พ.ย.: 07.00 น. ตักบาตร • 08.00 น. ถวายภัตตาหาร • 10.39 น. ถวายผ้ากฐินสามัคคี • 13.19 น. พิธียกเสาเอกเจดีย์ โดยสมเด็จพระวชิรสิทธาจารย์ (วัดสระเกศ) &amp; มทภ.2"/>
                <para Alignment="0"/>
                <para Alignment="0"/>
                <Content Font="Noto Serif Thai Regular" FontSize="5.8" Chars="★ บ้านเกาะแก้ว ต.ปากช่อง อ.ปากช่อง จ.นครราชสีมา ★"/>
                <trail Alignment="0"/>
            </StoryText>
        </PageObject>
