            </StoryText>
        </PageObject>
        <PageObject XPosition="134.015748031496" YPosition="1001.10236220472" OwnPage="1" ItemID="370298107" ItemType="4" Width="527.244094488189" Height="21.259842519685" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L527.244 0 L527.244 21.2598 L0 21.2598 L0 0 Z" ContourLinePath="M0 0 L527.244 0 L527.244 21.2598 L0 21.2598 L0 0 Z" gXpos="134.015748031496" gYpos="1001.10236220472" gWidth="0" gHeight="0" Alignment="1" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="1" Font="Liberation Serif Italic" FontSize="7.5"/>
                <Content Font="Liberation Serif Italic" FontSize="7.5" Chars="A forensic examination of observational case-counting windows, cohort misclassification, and the immortal time bias that manufactured consensus out of thin air."/>
                <trail Alignment="1"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="119.842519685039" YPosition="1025.1968503937" OwnPage="1" ItemID="1926826242" ItemType="5" Width="555.590551181102" Height="1" FrameType="0" ClipEdited="0" LineWidth="0.6" FillShade="3.65608577922522e-322" LineColor="Black" LinePenStyle="1" Path="" gXpos="119.842519685039" gYpos="1025.1968503937" gWidth="0" gHeight="0" Layer="0"/>
        <PageObject XPosition="119.842519685039" YPosition="1029.44881889764" OwnPage="1" ItemID="515275773" ItemType="6" Width="325.984251968504" Height="212.59842519685" FrameType="0" ClipEdited="0" LineWidth="0.5" FillColor="White" LineColor="Black" LinePenStyle="1" Path="M0 0 L325.984 0 L325.984 212.598 L0 212.598 L0 0 Z" ContourLinePath="M0 0 L325.984 0 L325.984 212.598 L0 212.598 L0 0 Z" gXpos="119.842519685039" gYpos="1029.44881889764" gWidth="0" gHeight="0" Layer="0"/>
        <PageObject XPosition="121.259842519685" YPosition="1030.86614173228" OwnPage="1" ItemID="521651520" ItemType="2" Width="323.149606299213" Height="209.763779527559" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="0.234111361079865" ImageScaleY="0.234111361079865" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="0" ImageRatio="1" ImagePageNumber="0" ImageFileName="issue-03/ads/fourteen_day_arithmancy_woodcut.jpg" ImageColorimetricIntent="0" UseEmbeddedProfile="0" Path="M0 0 L323.15 0 L323.15 209.764 L0 209.764 L0 0 Z" ContourLinePath="M0 0 L323.15 0 L323.15 209.764 L0 209.764 L0 0 Z" gXpos="121.259842519685" gYpos="1030.86614173228" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1"/>
        <PageObject XPosition="454.330708661417" YPosition="1029.44881889764" OwnPage="1" ItemID="783652484" ItemType="4" Width="221.102362204724" Height="212.59842519685" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L221.102 0 L221.102 212.598 L0 212.598 L0 0 Z" ContourLinePath="M0 0 L221.102 0 L221.102 212.598 L0 212.598 L0 0 Z" gXpos="454.330708661417" gYpos="1029.44881889764" gWidth="0" gHeight="0" Alignment="3" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="3" Font="Liberation Serif Regular" FontSize="7.2"/>
                <Content Font="Liberation Serif Regular" FontSize="7.2" Chars="To question the clinical trials of the Grand Apothecary was folly; to scrutinise their denominator was heresy. Yet when the history of the Great Contagion of 2021–2024 is written by dispassionate chroniclers, the central artefact of official deception will not be biological, but arithmantical."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="7.2" Chars="At St. Mungo’s Hospital for Magical Maladies, the records department operated under a decree of sublime administrative sorcery: no citizen receiving an experimental draught was classified as 'inoculated' until precisely fourteen days had elapsed following the second dose."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="7.2" Chars="To the untrained layman, this appeared a reasonable concession to biological latency—an allowance for antibodies to mature in the bloodstream. To the forensic statistician, however, it constituted a lethal mathematical sleight of hand."/>
                <trail Alignment="3"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="119.842519685039" YPosition="1247.71653543307" OwnPage="1" ItemID="2088741039" ItemType="5" Width="555.590551181102" Height="1" FrameType="0" ClipEdited="0" LineWidth="0.5" FillShade="2.1393042464926e-321" LineColor="Black" LinePenStyle="1" Path="" gXpos="119.842519685039" gYpos="1247.71653543307" gWidth="0" gHeight="0" Layer="0"/>
        <PageObject XPosition="119.842519685039" YPosition="1253.38582677165" OwnPage="1" ItemID="1756660448" ItemType="4" Width="555.590551181102" Height="450.708661417323" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="3" ColumnGap="17.007874015748" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L555.591 0 L555.591 450.709 L0 450.709 L0 0 Z" ContourLinePath="M0 0 L555.591 0 L555.591 450.709 L0 450.709 L0 0 Z" gXpos="119.842519685039" gYpos="1253.38582677165" gWidth="0" gHeight="0" Alignment="3" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="3" Font="Liberation Serif Regular" FontSize="6.8"/>
                <Content Font="Liberation Serif Regular" FontSize="6.8" Chars="Consider the epidemiological mechanics of the 14-day window. If an individual experienced an acute adverse cardiovascular reaction, pulmonary collapse, or fatal thrombosis on Day 3 following inoculation, where did their casualty record land? Under the Ministry’s statutory definitions, they had not yet attained the holy fourteen-day threshold."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.8" Chars="Consequently, they were categorized and tallied in the hospital ledgers as an 'unvaccinated death.' The very intervention being evaluated was thus mathematically cleansed of its immediate post-administration perils. Worse still, the burden of those early casualties was dumped into the baseline tally of the untreated control cohort!"/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.8" Chars="This phenomenon, well-known in classical biostatistics as 'immortal time bias' and 'case-counting window manipulation,' created an artificial statistical divergence that guaranteed an appearance of overwhelming efficacy. The newly inoculated cohort was declared immune from counting during its period of highest biological vulnerability, while the non-compliant cohort absorbed every stray malady."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.8" Chars="When independent arithmancers in the Citadel recalculated the raw mortality data using an honest 'intention-to-treat' timeline—counting every soul from the moment the needle entered the flesh—the miraculous divergence vanished into Poisson noise."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.8" Chars="The institutional response was swift and predictable: those who pointed out the denominator trick were branded 'Arithmancy Deniers,' stripped of their clinical wands, and exiled from academic journals. The public health apparatus had invested its entire institutional credibility in the dogma that the potion was safe and effective; to concede that the efficacy metric was an artefact of case-window gerrymandering was an existential impossibility."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.8" Chars="As sovereign citizens reflecting upon this dark era, the lesson transcends pharmacology. Whenever the state or its captured cartels present an authoritative statistical consensus, look not at the numerator of promised salvation; inspect the denominator, check the exclusion windows, and demand to see the unconfirmed raw ledger. Don't trust the apothecary; verify the arithmetic."/>
                <trail Alignment="3"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="119.842519685039" YPosition="1711.1811023622" OwnPage="1" ItemID="540732525" ItemType="5" Width="555.590551181102" Height="1" FrameType="0" ClipEdited="0" LineWidth="1" FillShade="0" LineColor="Black" LinePenStyle="1" Path="" gXpos="119.842519685039" gYpos="1711.1811023622" gWidth="0" gHeight="0" Layer="0"/>
