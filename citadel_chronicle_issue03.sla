                <Content Font="Liberation Mono Regular" FontSize="5" Chars="• ROAST PORK: Subsidised"/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5" Chars="• STREET VENDORS: Condemned"/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5" Chars="• SOVEREIGN SEEDS: Confiscated"/>
                <para/>
                <Content Font="Liberation Mono Regular" FontSize="5" Chars="[Zero Legal Recourse]"/>
                <trail/>
            </StoryText>
