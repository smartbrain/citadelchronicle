                <trail/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="125.511811023622" YPosition="2988.8188976378" OwnPage="3" ItemID="1078184380" ItemType="4" Width="328.818897637795" Height="21.259842519685" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L328.819 0 L328.819 21.2598 L0 21.2598 L0 0 Z" ContourLinePath="M0 0 L328.819 0 L328.819 21.2598 L0 21.2598 L0 0 Z" gXpos="125.511811023622" gYpos="2988.8188976378" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Font="Liberation Serif Italic" FontSize="6.5"/>
                <Content Font="Liberation Serif Italic" FontSize="6.5" Chars="How a delivery of frozen sausages revived a sixteen-year-old epiphany in Chiang Mai on the true price of capital, the cruelty of interest rate caps, and the moral hazard of the nanny state."/>
                <trail/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="125.511811023622" YPosition="3011.49606299213" OwnPage="3" ItemID="1081350860" ItemType="6" Width="328.818897637795" Height="175.748031496063" FrameType="0" ClipEdited="0" LineWidth="0.5" FillColor="White" LineColor="Black" LinePenStyle="1" Path="M0 0 L328.819 0 L328.819 175.748 L0 175.748 L0 0 Z" ContourLinePath="M0 0 L328.819 0 L328.819 175.748 L0 175.748 L0 0 Z" gXpos="125.511811023622" gYpos="3011.49606299213" gWidth="0" gHeight="0" Layer="0"/>
        <PageObject XPosition="126.929133858268" YPosition="3012.91338582677" OwnPage="3" ItemID="1071260372" ItemType="2" Width="325.984251968504" Height="172.913385826772" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="0.225147637795276" ImageScaleY="0.225147637795276" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="0" ImageRatio="1" ImagePageNumber="0" ImageFileName="issue-03/ads/motorcycle_18percent_woodcut.jpg" ImageColorimetricIntent="0" UseEmbeddedProfile="0" Path="M0 0 L325.984 0 L325.984 172.913 L0 172.913 L0 0 Z" ContourLinePath="M0 0 L325.984 0 L325.984 172.913 L0 172.913 L0 0 Z" gXpos="126.929133858268" gYpos="3012.91338582677" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1"/>
        <PageObject XPosition="125.511811023622" YPosition="3188.66141732283" OwnPage="3" ItemID="1810640822" ItemType="4" Width="328.818897637795" Height="12.755905511811" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L328.819 0 L328.819 12.7559 L0 12.7559 L0 0 Z" ContourLinePath="M0 0 L328.819 0 L328.819 12.7559 L0 12.7559 L0 0 Z" gXpos="125.511811023622" gYpos="3188.66141732283" gWidth="0" gHeight="0" Alignment="1" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="1" Font="Liberation Serif Italic" FontSize="5.5"/>
                <Content Font="Liberation Serif Italic" FontSize="5.5" Chars="Plate 4: The 18% Northern Sovereign Rider. A modest motorcycle transforms an informal labourer into an independent enterprise. In the clouds above: the towering silhouette of an IBM P-Series database server."/>
                <trail Alignment="1"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="125.511811023622" YPosition="3202.83464566929" OwnPage="3" ItemID="264480537" ItemType="5" Width="323.149606299213" Height="1" FrameType="0" ClipEdited="0" LineWidth="0.5" FillShade="2.1393042464926e-321" LineColor="GreyRule" LinePenStyle="1" Path="" gXpos="125.511811023622" gYpos="3202.83464566929" gWidth="0" gHeight="0" Layer="0"/>
        <PageObject XPosition="125.511811023622" YPosition="3207.08661417323" OwnPage="3" ItemID="433990624" ItemType="4" Width="328.818897637795" Height="249.448818897638" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="2" ColumnGap="17.007874015748" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L328.819 0 L328.819 249.449 L0 249.449 L0 0 Z" ContourLinePath="M0 0 L328.819 0 L328.819 249.449 L0 249.449 L0 0 Z" gXpos="125.511811023622" gYpos="3207.08661417323" gWidth="0" gHeight="0" Alignment="3" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle Alignment="3" Font="Liberation Serif Regular" FontSize="6.4"/>
                <Content Font="Liberation Serif Regular" FontSize="6.4" Chars="This morning, an express van pulled up to my gate to deliver a parcel of frozen sausages dispatched from Ratchaburi. Emblazoned across the vehicle was the livery of NIM Express. It is a peculiar facet of human memory that an ordinary parcel of breakfast meat can instantly dislodge an encounter buried sixteen years in the past."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.4" Chars="In September 2010, I was covering technology for the Post Database at the Bangkok Post. IBM had ferried a contingent of tech journalists to Chiang Mai for what polite society terms a “geo-expansion showcase”—what the rest of us recognized as a corporate fluff junket. Big Blue was strutting its northern conquests: 70 terabytes of medical storage for Chiang Mai University, modular containerised data centres, and Lotus Live suites."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.4" Chars="Tucked into the briefing pack as a star regional showcase was Nim See Seng Leasing. They commanded 233 branches across eight northern provinces, powered by centralised IBM P-Series servers and DB2 databases. Their core business? Providing vehicle and motorcycle loans to low-income, informal-sector borrowers who could never dream of securing an audience with a commercial bank."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.4" Chars="The executives presented their metrics with straight faces and unmistakable corporate pride: Nim, they beamed, was performing an uplifting social service by lending at “only” 18 per cent annual interest."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.4" Chars="Eighteen per cent! Sitting in that air-conditioned ballroom as a comfortable urban scribe, my jaw hit the parquet. Eighteen per cent interest, and they called it cheap? Was this not textbook usurious predation—capitalist financiers extracting blood from the poorest labourers on two wheels?"/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.4" Chars="Then I checked my reporting notes from the provincial streets. The prevailing uncollateralised street rate charged by village loan sharks across the north was 25 per cent. Often higher. Often compounded monthly, and collected under the implicit threat of a lead pipe."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.4" Chars="Now that I am sixteen years older—and, one hopes, a fraction wiser—I find myself returning often to that Chiang Mai epiphany. High interest rates are not inherently an evil conspiracy of elites feasting upon the destitute. Rather, interest is the honest, unvarnished market price of risk."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.4" Chars="What is “fair”? What is “access”? If righteous paternalists in parliament pass an edict capping interest rates out of ostensible compassion, what actually happens? The laws of risk do not bow to ministerial decrees. Two things inevitably follow: either the man at the bottom of the pyramid is denied the motorcycle that allows him to commute and earn his livelihood; or he is driven straight back into the shadows of the loan shark at 25, 30, or 50 per cent."/>
                <para Alignment="3"/>
                <para Alignment="3"/>
                <Content Font="Liberation Serif Regular" FontSize="6.4" Chars="In pretending that high-risk capital should be artificially cheap, the state does not protect the vulnerable; it subsidises moral hazard, breeds a sub-class dependent on perpetual debt moratoria and bailouts, and outlaws the bottom rungs of the formal credit ladder. The market price of risk is uncomfortable. The state’s compassionate illusion is ruinous."/>
                <trail Alignment="3"/>
            </StoryText>
        </PageObject>
